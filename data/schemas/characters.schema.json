{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "Fargo characters",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name_en", "name_he", "seasons", "faction", "fate", "bio_en", "bio_he", "also_known_as"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "name_en": { "type": "string", "minLength": 1 },
      "name_he": { "type": "string", "minLength": 1 },
      "seasons": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "faction": { "enum": ["law", "crime", "civilian", "drifter"] },
      "fate": { "enum": ["alive", "dead", "unknown"] },
      "bio_en": { "type": "string", "minLength": 1, "maxWords": 60 },
      "bio_he": { "type": "string", "minLength": 1, "maxWords": 60 },
      "also_known_as": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
    }
  }
}
